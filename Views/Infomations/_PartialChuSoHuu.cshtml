@model List<NiceHandles.Models.PersonInfo>
@using NiceHandles.Models

<link href="~/Content/css/info-chusohuu.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title">
                        <i class="fa fa-users"></i> Thông tin chủ sở hữu
                        <button type="button" class="btn btn-sm btn-primary pull-right" id="btnAddOwner">
                            <i class="fa fa-plus"></i> Thêm chủ sở hữu
                        </button>
                    </h4>
                </div>
                <div class="panel-body">
                    <div id="ownersList">
                      
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var owner = Model[i];
                            var index = i;

                            <div class="owner-item" data-index="@index">
                                <div class="row">
                                    <div class="col-md-6">
                                        <fieldset>
                                            <legend class="owner-legend">
                                                <i class="fa fa-user"></i> Chủ sở hữu @(index + 1)
                                                @if (index > 0)
                                                {
                                                    <button type="button" class="btn btn-sm btn-danger pull-right btn-remove-owner" data-index="@index">
                                                        <i class="fa fa-trash"></i> Xóa
                                                    </button>
                                                }
                                            </legend>

                                            <!-- Scan CCCD Section -->
                                            <div class="scan-section">
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <input type="file" id="inputFile_@index" accept=".jpg,.jpeg,.png,.pdf" class="form-control scan-input" data-index="@index" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <button type="button" class="btn btn-scan btn-upload-cccd" data-index="@index" id="uploadButton">
                                                            <i class="fa fa-camera"></i> Quét CCCD
                                                        </button>
                                                    </div>
                                                </div>
                                                <div id="loading_@index" style="display:none;" class="mt-2">
                                                    <div class="spinner-border text-primary" role="status">
                                                        <span class="sr-only">Đang xử lý...</span>
                                                    </div>
                                                </div>
                                                <div id="results_@index" class="mt-2"></div>
                                            </div>

                                            <!-- Thông tin cá nhân -->
                                            <div class="form-group">
                                                <label class="control-label col-md-3">Họ và tên</label>
                                                <div class="col-md-9">
                                                    <input type="text"
                                                           name="PersonInfos[@index].FullName"
                                                           value="@owner.FullName"
                                                           class="form-control"
                                                           placeholder="Nhập họ tên đầy đủ" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Ngày sinh</label>
                                                <div class="col-md-9">
                                                    <input type="text"
                                                           name="PersonInfos[@index].BirthDate"
                                                           value="@(owner.BirthDate?.ToString("dd/MM/yyyy"))"
                                                           class="form-control datetime"
                                                           placeholder="dd/MM/yyyy" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Giới tính</label>
                                                <div class="col-md-9">
                                                    <div class="btn-group" role="group">
                                                        <input type="radio"
                                                               class="btn-check"
                                                               name="PersonInfos[@index].Gender"
                                                               value="Nam"
                                                               id="gender_@(index)_nam"
                                                               @(owner.Gender == "Nam" ? "checked" : "")
                                                               style="display: none;" />
                                                        <label class="btn btn-outline-primary" for="gender_@(index)_nam">Nam</label>

                                                        <input type="radio"
                                                               class="btn-check"
                                                               name="PersonInfos[@index].Gender"
                                                               value="Nữ"
                                                               id="gender_@(index)_nu"
                                                               @(owner.Gender == "Nữ" ? "checked" : "")
                                                               style="display: none;" />
                                                        <label class="btn btn-outline-primary" for="gender_@(index)_nu">Nữ</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Địa chỉ thường trú</label>
                                                <div class="col-md-9">
                                                    <textarea name="PersonInfos[@index].DocumentAddress"
                                                              class="form-control"
                                                              rows="3"
                                                              placeholder="Nhập địa chỉ thường trú đầy đủ">@(owner.DocumentAddress)</textarea>
                                                    @if (index > 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-info btn-same-address mt-2" data-index="@index">
                                                            <i class="fa fa-copy"></i> Như người thứ nhất
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>

                                    <div class="col-md-6">
                                        <fieldset>
                                            <legend>Giấy tờ tùy thân</legend>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Loại giấy tờ</label>
                                                <div class="col-md-9">
                                                    <div class="btn-group" role="group">
                                                        @{
                                                            var docTypes = new[] {
                                                                new { Value = "CCCD", Text = "CCCD" },
                                                                new { Value = "Căn Cước", Text = "Căn cước" },
                                                                new { Value = "Số định danh", Text = "SĐD" },
                                                                new { Value = "CMND", Text = "CMND" }
                                                            };
                                                        }
                                                        @foreach (var dt in docTypes)
                                                        {
                                                            var dtId = $"doctype_{index}_{dt.Value}";
                                                            <input type="radio"
                                                                   class="btn-check"
                                                                   name="PersonInfos[@index].DocumentType"
                                                                   value="@dt.Value"
                                                                   id="@dtId"
                                                                   @(owner.DocumentType == dt.Value ? "checked" : "")
                                                                   style="display: none;" />
                                                            <label class="btn btn-outline-primary" for="@dtId">@dt.Text</label>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Số giấy tờ</label>
                                                <div class="col-md-9">
                                                    <input type="text"
                                                           name="PersonInfos[@index].DocumentNumber"
                                                           value="@owner.DocumentNumber"
                                                           class="form-control"
                                                           placeholder="Nhập số CCCD/CMND" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Ngày cấp</label>
                                                <div class="col-md-9">
                                                    <input type="text"
                                                           name="PersonInfos[@index].IssueDate"
                                                           value="@(owner.IssueDate?.ToString("dd/MM/yyyy"))"
                                                           class="form-control datetime"
                                                           placeholder="dd/MM/yyyy" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Nơi cấp</label>
                                                <div class="col-md-9">
                                                    <input type="text"
                                                           name="PersonInfos[@index].Issuer"
                                                           value="@owner.Issuer"
                                                           class="form-control"
                                                           placeholder="Cục Cảnh sát QLHC về TTXH" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="control-label col-md-3">Mã số thuế</label>
                                                <div class="col-md-9">
                                                    <input type="text"
                                                           name="PersonInfos[@index].TaxCode"
                                                           value="@owner.TaxCode"
                                                           class="form-control"
                                                           placeholder="Nhập mã số thuế (nếu có)" />
                                                </div>
                                            </div>

                                            @if (index > 0)
                                            {
                                                <div class="form-group">
                                                    <label class="control-label col-md-3">Quan hệ với CSH 1</label>
                                                    <div class="col-md-9">
                                                        <select name="PersonInfos[@index].RelationshipType" class="form-control">
                                                            <option value="">-- Chọn quan hệ --</option>
                                                            <option value="VoChong">Vợ/Chồng</option>
                                                            <option value="ConCai">Con cái</option>
                                                            <option value="BoMe">Bố/Mẹ</option>
                                                            <option value="AnhChiEm">Anh/Chị/Em</option>
                                                            <option value="SuDungChung">Sử dụng chung</option>
                                                            <option value="Khac">Khác</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            }

                                            <!-- Hidden fields for PersonInfo Id -->
                                            <input type="hidden" name="PersonInfos[@index].Id" value="@owner.Id" />
                                        </fieldset>
                                    </div>
                                </div>
                                @if (i < Model.Count - 1)
                                {
                                    <hr class="owner-separator" />
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Template for new owner (hidden) -->
<script type="text/html" id="ownerTemplate">
    <div class="owner-item" data-index="{{index}}">
        <div class="row">
            <div class="col-md-6">
                <fieldset>
                    <legend class="owner-legend">
                        <i class="fa fa-user"></i> Chủ sở hữu {{displayIndex}}
                        <button type="button" class="btn btn-sm btn-danger pull-right btn-remove-owner" data-index="{{index}}">
                            <i class="fa fa-trash"></i> Xóa
                        </button>
                    </legend>

                    <!-- Scan CCCD Section -->
                    <div class="scan-section">
                        <div class="row">
                            <div class="col-md-8">
                                <input type="file" id="inputFile_{{index}}" accept=".jpg,.jpeg,.png,.pdf" class="form-control scan-input" data-index="{{index}}" />
                            </div>
                            <div class="col-md-4">
                                <button type="button" class="btn btn-scan btn-upload-cccd" data-index="{{index}}">
                                    <i class="fa fa-camera"></i> Quét CCCD
                                </button>
                            </div>
                        </div>
                        <div id="loading_{{index}}" style="display:none;" class="mt-2">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Đang xử lý...</span>
                            </div>
                        </div>
                        <div id="results_{{index}}" class="mt-2"></div>
                    </div>

                    <!-- Thông tin cá nhân -->
                    <div class="form-group">
                        <label class="control-label col-md-3">Họ và tên</label>
                        <div class="col-md-9">
                            <input type="text" name="PersonInfos[{{index}}].FullName" class="form-control" placeholder="Nhập họ tên đầy đủ" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Ngày sinh</label>
                        <div class="col-md-9">
                            <input type="text" name="PersonInfos[{{index}}].BirthDate" class="form-control datetime" placeholder="dd/MM/yyyy" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Giới tính</label>
                        <div class="col-md-9">
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" name="PersonInfos[{{index}}].Gender" value="Nam" id="gender_{{index}}_nam" checked style="display: none;" />
                                <label class="btn btn-outline-primary" for="gender_{{index}}_nam">Nam</label>
                                <input type="radio" class="btn-check" name="PersonInfos[{{index}}].Gender" value="Nữ" id="gender_{{index}}_nu" style="display: none;" />
                                <label class="btn btn-outline-primary" for="gender_{{index}}_nu">Nữ</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Địa chỉ thường trú</label>
                        <div class="col-md-9">
                            <textarea name="PersonInfos[{{index}}].Address.FullAddress" class="form-control" rows="3" placeholder="Nhập địa chỉ thường trú đầy đủ"></textarea>
                            <button type="button" class="btn btn-sm btn-info btn-same-address mt-2" data-index="{{index}}">
                                <i class="fa fa-copy"></i> Như người thứ nhất
                            </button>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="col-md-6">
                <fieldset>
                    <legend>Giấy tờ tùy thân</legend>

                    <div class="form-group">
                        <label class="control-label col-md-3">Loại giấy tờ</label>
                        <div class="col-md-9">
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" name="PersonInfos[{{index}}].DocumentType" value="CCCD" id="doctype_{{index}}_CCCD" checked style="display: none;" />
                                <label class="btn btn-outline-primary" for="doctype_{{index}}_CCCD">CCCD</label>
                                <input type="radio" class="btn-check" name="PersonInfos[{{index}}].DocumentType" value="Căn Cước" id="doctype_{{index}}_CC" style="display: none;" />
                                <label class="btn btn-outline-primary" for="doctype_{{index}}_CC">Căn cước</label>
                                <input type="radio" class="btn-check" name="PersonInfos[{{index}}].DocumentType" value="Số định danh" id="doctype_{{index}}_SDD" style="display: none;" />
                                <label class="btn btn-outline-primary" for="doctype_{{index}}_SDD">SĐD</label>
                                <input type="radio" class="btn-check" name="PersonInfos[{{index}}].DocumentType" value="CMND" id="doctype_{{index}}_CMND" style="display: none;" />
                                <label class="btn btn-outline-primary" for="doctype_{{index}}_CMND">CMND</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Số giấy tờ</label>
                        <div class="col-md-9">
                            <input type="text" name="PersonInfos[{{index}}].DocumentNumber" class="form-control" placeholder="Nhập số CCCD/CMND" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Ngày cấp</label>
                        <div class="col-md-9">
                            <input type="text" name="PersonInfos[{{index}}].IssueDate" class="form-control datetime" placeholder="dd/MM/yyyy" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Nơi cấp</label>
                        <div class="col-md-9">
                            <input type="text" name="PersonInfos[{{index}}].Issuer" class="form-control" placeholder="Cục Cảnh sát QLHC về TTXH" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Mã số thuế</label>
                        <div class="col-md-9">
                            <input type="text" name="PersonInfos[{{index}}].TaxCode" class="form-control" placeholder="Nhập mã số thuế (nếu có)" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Quan hệ với CSH 1</label>
                        <div class="col-md-9">
                            <select name="PersonInfos[{{index}}].RelationshipType" class="form-control">
                                <option value="">-- Chọn quan hệ --</option>
                                <option value="VoChong">Vợ/Chồng</option>
                                <option value="ConCai">Con cái</option>
                                <option value="BoMe">Bố/Mẹ</option>
                                <option value="AnhChiEm">Anh/Chị/Em</option>
                                <option value="SuDungChung">Sử dụng chung</option>
                                <option value="Khac">Khác</option>
                            </select>
                        </div>
                    </div>

                    <input type="hidden" name="PersonInfos[{{index}}].Id" value="0" />
                </fieldset>
            </div>
        </div>
        <hr class="owner-separator" />
    </div>
</script>



<style>
    .owner-item {
        margin-bottom: 20px;
        padding: 15px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background-color: #f9f9f9;
    }

    .owner-legend {
        font-size: 18px;
        font-weight: bold;
        color: #337ab7;
        border-bottom: 2px solid #337ab7;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    .owner-separator {
        border-top: 2px solid #ddd;
        margin: 20px 0;
    }

    .btn-same-address {
        margin-top: 5px;
    }

    .scan-section {
        margin-bottom: 20px;
        padding: 10px;
        background-color: #f0f0f0;
        border-radius: 5px;
    }

    .btn-scan {
        background-color: #5cb85c;
        color: white;
        border: none;
    }

        .btn-scan:hover {
            background-color: #449d44;
        }

    .form-group {
        margin-bottom: 15px;
    }

    .control-label {
        font-weight: bold;
    }

    fieldset {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 5px;
    }

    legend {
        width: auto;
        padding: 0 10px;
        margin-bottom: 10px;
        font-size: 16px;
        font-weight: bold;
    }
</style>