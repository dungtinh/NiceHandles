@model List<NiceHandles.Models.PersonInfoDto>
@using (Html.BeginForm("SaveLandParcel", "HoSoes", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    <div class="tab-pane" id="persons">
        <div class="form-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="section-title mb-0">Danh sách người liên quan</h4>
                <button type="button" class="btn btn-success" id="btnAddPerson">
                    <i class="fa fa-plus"></i> Thêm người
                </button>
            </div>

            <div id="personsContainer">
                @if (Model != null && Model.Any())
                {
                    for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="person-card" data-index="@i">
                            @Html.Partial("_PersonForm", Model[i], new ViewDataDictionary { { "Index", i } })
                        </div>
                    }
                }
            </div>
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fa fa-save"></i> Lưu thông tin
                </button>
            </div>
        </div>
    </div>
}